<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ : l'écran de lancement est dessiné par le système à partir de ces valeurs.
         Sans elles, il affiche l'icône dans un disque blanc sur fond noir en mode sombre. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#1E3A5F</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
